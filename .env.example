# --- MongoDB ---
# Sajat, a gazdagepen futo Mongo (ez az alapertelmezes):
MONGO_URL=mongodb://host.docker.internal:27017
# Ha a "local-mongo" profillal inditod a compose-t, akkor viszont:
# MONGO_URL=mongodb://mongo:27017
MONGO_DB=pumpdump

# --- Telegram ---
# Elso indulaskor bekerul a Mongo config collectionbe, utana ott is modosithato
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Binance ---
# Csak akkor kell, ha az auto trading be lesz kapcsolva
BINANCE_API_KEY=
BINANCE_API_SECRET=
FUTURES_TESTNET=0
